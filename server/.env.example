PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/prince-patel-studio
# At least 32 random characters
JWT_SECRET=
# Comma-separated list of frontend origins allowed to call this API
CLIENT_ORIGIN=http://localhost:5173
# Optional: enables reference-file uploads. Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
# Used only by `npm run create-admin`
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Name printed on quotation PDFs
BRAND_NAME=Prince Patel
# Optional: enables "Send by email" for quotations. Leave blank to send quotes yourself (e.g. WhatsApp).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
