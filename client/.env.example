# --- Contact (also editable later in Admin > Settings) ---
# WhatsApp: country code + number, digits only (e.g. 919876543210)
VITE_WHATSAPP_NUMBER=
VITE_PUBLIC_CONTACT_EMAIL=
VITE_PUBLIC_PHONE=

# --- Site and API ---
# Your live site address, no trailing slash. Used for canonical links and the sitemap.
VITE_SITE_URL=http://localhost:5173
# Your API address including /api. Local: http://localhost:5000/api
VITE_API_URL=http://localhost:5000/api
